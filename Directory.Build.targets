<Project>
  <PropertyGroup Condition="'$(HostAtomicSdkProject)' != ''">
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/obj/host-atomic-candidate.packages.lock.json</NuGetLockFilePath>
    <DefineConstants>$(DefineConstants);HOST_ATOMIC_DIRECTORY_CANDIDATE</DefineConstants>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <ItemGroup Condition="'$(HostAtomicSdkProject)' != '' And
      ('$(MSBuildProjectName)' == 'MirrorPulse.Core' Or '$(MSBuildProjectName)' == 'MirrorPulse.Core.Tests' Or
       '$(MSBuildProjectName)' == 'MirrorPulse.CloudFiles.CfSharp' Or '$(MSBuildProjectName)' == 'MirrorPulse.CloudFiles.CfSharp.Tests' Or
       '$(MSBuildProjectName)' == 'MirrorPulse.Adapter.Ftp.Worker' Or '$(MSBuildProjectName)' == 'MirrorPulse.Adapter.Sftp.Worker')">
    <PackageReference Remove="MirrorPulse.Adapter.Sdk" />
    <ProjectReference Include="$(HostAtomicSdkProject)" />
  </ItemGroup>
</Project>
