<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <ProjectReference Include="..\MirrorPulse.CloudFiles.CfSharp\MirrorPulse.CloudFiles.CfSharp.csproj" />
    <ProjectReference Include="..\MirrorPulse.Control\MirrorPulse.Control.csproj" />
    <ProjectReference Include="..\MirrorPulse.Core\MirrorPulse.Core.csproj" />
  </ItemGroup>

  <Target Name="IncludeMirrorPulseEditionAdapters" BeforeTargets="AssignTargetPaths"
          Condition="'@(MirrorPulseEditionDefaultAdapter)' != ''">
    <Error Condition="'%(MirrorPulseEditionDefaultAdapter.Extension)' != '.mpadapter' or !Exists('%(MirrorPulseEditionDefaultAdapter.FullPath)')"
           Text="Each bundled Adapter must reference an existing .mpadapter file." />
    <ItemGroup>
      <Content Include="%(MirrorPulseEditionDefaultAdapter.FullPath)"
               TargetPath="edition-adapters\adapter.%(MirrorPulseEditionDefaultAdapter.AdapterId).mpadapter"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="%(MirrorPulseEditionDefaultAdapter.FullPath).signature.json"
               Condition="Exists('%(MirrorPulseEditionDefaultAdapter.FullPath).signature.json')"
               TargetPath="edition-adapters\adapter.%(MirrorPulseEditionDefaultAdapter.AdapterId).mpadapter.signature.json"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
