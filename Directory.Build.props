<Project>
  <PropertyGroup Condition="'$(MirrorPulseEditionProfile)' != ''">
    <MirrorPulseEditionProfilePath>$([System.IO.Path]::GetFullPath('$(MirrorPulseEditionProfile)', '$(MSBuildStartupDirectory)'))</MirrorPulseEditionProfilePath>
  </PropertyGroup>
  <Import Project="$(MirrorPulseEditionProfilePath)" Condition="'$(MirrorPulseEditionProfilePath)' != ''" />

  <PropertyGroup>
    <MirrorPulseEditionId Condition="'$(MirrorPulseEditionProfile)' == '' and '$(MirrorPulseEditionId)' == ''">standard</MirrorPulseEditionId>
    <MirrorPulseEditionName Condition="'$(MirrorPulseEditionId)' == 'standard' and '$(MirrorPulseEditionName)' == ''">MirrorPulse</MirrorPulseEditionName>
    <MirrorPulseEditionProviderId Condition="'$(MirrorPulseEditionId)' == 'standard' and '$(MirrorPulseEditionProviderId)' == ''">d194eacd-c38c-49df-a238-49871f9c8d1b</MirrorPulseEditionProviderId>
    <MirrorPulseEditionCommand Condition="'$(MirrorPulseEditionId)' == 'standard' and '$(MirrorPulseEditionCommand)' == ''">mp</MirrorPulseEditionCommand>
    <MirrorPulseEditionDirectAdapter Condition="'$(MirrorPulseEditionDirectAdapter)' == ''">false</MirrorPulseEditionDirectAdapter>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MirrorPulseEditionId)' != 'standard' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(MirrorPulseEditionId)', '^[a-z][a-z0-9]*(-[a-z0-9]+)*$'))">
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory)artifacts/editions/$(MirrorPulseEditionId)</ArtifactsPath>
  </PropertyGroup>
</Project>
